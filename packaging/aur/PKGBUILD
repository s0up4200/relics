# The release workflow builds the Arch package from this file.
pkgname=relics
pkgver=0.1.0
pkgrel=1
pkgdesc='Unofficial Silo client for Linux. Follows your Omarchy theme.'
arch=('x86_64')
url='https://github.com/s0up4200/relics'
license=('unknown')
depends=('mpv' 'wayland' 'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'vulkan-icd-loader' 'gcc-libs' 'glibc')
makedepends=('cargo' 'clang' 'cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
# Full debug info makes the build larger than the free disk of a CI runner.
options=('!debug')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  local identity
  identity=$(target/release/relics --version) || return 1
  if [[ "$identity" == *'(unknown)' ]]; then
    echo 'The package has no source commit.' >&2
    return 1
  fi
  # --release uses the dependencies of the release build, so they are not built again.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -Dm0644 -t "$pkgdir/usr/share/omarchy/default/hypr/apps/" data/relics.lua
  install -Dm0644 -t "$pkgdir/usr/share/applications/" data/relics.desktop
  install -Dm0644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/" data/relics.svg
}
